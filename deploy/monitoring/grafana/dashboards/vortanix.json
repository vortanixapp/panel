      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(db_pool_empty_acquire_total[5m])",
          "legendFormat": "ожиданий в секунду {{pool}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(db_pool_acquire_wait_seconds_total[5m])",
          "legendFormat": "секунд ожидания в секунду {{pool}}"
        }
      ]
    },
