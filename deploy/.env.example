# Скопируйте в deploy/.env и заполните. Без POSTGRES_PASSWORD, JWT_SECRET
# и SECRETS_KEY панель не поднимется — это не придирка, а защита от установки,
# которую откроет любой желающий.
#
#   cp deploy/.env.example deploy/.env
#
# Сгенерировать значения:
#   openssl rand -base64 32

POSTGRES_PASSWORD=
JWT_SECRET=
SECRETS_KEY=
INTERNAL_SECRET=

# Адрес, по которому панель видна снаружи. Браузер обращается к API по этому
# адресу, поэтому localhost годится только для проверки на своей машине.
PANEL_URL=http://localhost:8080

# Порты на хосте. Меняйте, если заняты.
WEB_PORT=3000
API_PORT=8080
RELAY_PORT=8082
CONSOLE_PORT=8083

# Откуда браузеру разрешено обращаться к API. Через запятую.
CORS_ORIGINS=http://localhost:3000

# Почта. Без неё панель работает, но письма о регистрации, сбросе пароля
# и оплате не уходят.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Вход через соцсети. Пустые значения просто убирают кнопки со страницы входа.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
