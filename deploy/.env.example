# Скопируйте в deploy/.env и заполните. Без POSTGRES_PASSWORD, JWT_SECRET
# и SECRETS_KEY панель не поднимется — это не придирка, а защита от установки,
# которую откроет любой желающий.
#
#   cp deploy/.env.example deploy/.env
#
# Пароль базы подставляется в адрес подключения postgres://vortanix:ПАРОЛЬ@...,
# поэтому символы /, +, @, : и # его ломают: адрес разберётся не туда, а
# сообщение об ошибке будет про порт. Берите шестнадцатеричный — в нём таких
# символов нет по построению:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Эти три в адреса не попадают, годится любой набор символов:
#   openssl rand -base64 32
JWT_SECRET=
SECRETS_KEY=
INTERNAL_SECRET=

# Адреса заполняет scripts/init-env.sh — руками их править обычно не нужно.
#
# SITE_ADDRESS — что слушает Caddy. Домен означает https с сертификатом
# Let's Encrypt; «http://адрес» — работу без шифрования, по IP.
SITE_ADDRESS=

# Всё живёт на одном адресе: панель, API, консоль и связь с нодами
# различаются путём, а не портом.
#
# RELAY_PUBLIC_URL — адрес, который панель выдаёт игровым нодам.
# FRONTEND_URL — адрес для ссылок в письмах.
RELAY_PUBLIC_URL=
FRONTEND_URL=

# Пустыми фронт берёт адрес того хоста, с которого его открыли. Заполнять
# нужно, только если API или консоль вынесены на отдельный домен.
PANEL_URL=
CONSOLE_URL=

# Порты Caddy на хосте. Меняйте, только если 80 и 443 уже заняты — но тогда
# Let's Encrypt не сможет выпустить сертификат, он ходит именно на 80.
HTTP_PORT=80
HTTPS_PORT=443

# Откуда браузеру разрешено обращаться к API. Пустой значит «откуда угодно»:
# панель не выдаёт cookie, вход идёт по Bearer-токену, и браузер не приложит
# его к запросу чужого сайта. При работе через Caddy источник и так один.
CORS_ORIGINS=

# Реестр, из которого ноды тянут образы игр. Пустой означает Docker Hub, где
# этих образов нет: соберите четыре рантайма через scripts/build-game-images.sh,
# запушьте в свой реестр и укажите его здесь. Иначе создание сервера упадёт
# на загрузке образа.
VORTANIX_REGISTRY=

# Образ агента для игровых нод. Меняйте, если собираете его сами.
AGENT_IMAGE=ghcr.io/vortanixapp/vortanix-agent:latest

# Проверка обновлений. Запрос к GitHub уходит только когда владелец открывает
# вкладку «Обновления» или нажимает «Проверить снова» — фоновых обращений нет.
# Пустой UPDATE_REPO выключает проверку совсем.
UPDATE_REPO=vortanixapp/panel
# Токен нужен, только если 60 запросов в час с вашего адреса не хватает
# (GitHub считает их на анонимных) или репозиторий закрытый.
UPDATE_GITHUB_TOKEN=
# Для GitHub Enterprise: адрес его API вместо публичного.
UPDATE_API_BASE=

# Почта. Без неё панель работает, но письма о регистрации, сбросе пароля
# и оплате не уходят.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Вход через соцсети. Пустые значения просто убирают кнопки со страницы входа.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
