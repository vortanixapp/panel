# Панель Vortanix на машине клиента.
# Скопируйте в .env и заполните: cp .env.example .env

# Ключ из кабинета Vortanix. Им же апдейтер получает целевую версию.
LICENSE_KEY=VRTX-XXXX-XXXX-XXXX

# Адреса нашего backend'а
NEXT_PUBLIC_API_URL=https://api.vortanix.app
NEXT_PUBLIC_CONSOLE_URL=wss://console.vortanix.app
LICENSE_URL=https://license.vortanix.app

# Ваш арендатор и бренд
NEXT_PUBLIC_TENANT_SLUG=your-slug
NEXT_PUBLIC_BRAND_NAME=YOUR BRAND
NEXT_PUBLIC_BRAND_LOGO_URL=

# Порт, на котором панель слушает на хосте (перед ней обычно стоит nginx)
PANEL_PORT=3000

# Окно обслуживания в местном времени. Обновление применяется только в нём —
# кроме обязательных, у которых наступил дедлайн. Пустое значение = в любое время.
UPDATE_WINDOW=03:00-05:00

# Версия панели при первой установке. Дальше её ведёт апдейтер.
PANEL_IMAGE=registry.vortanix.app/vortanix/panel-ui
PANEL_VERSION=latest
UPDATER_IMAGE=registry.vortanix.app/vortanix/updater
UPDATER_VERSION=latest
